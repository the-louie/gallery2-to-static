{
  "name": "gallery2-to-static-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "size-limit": [
    {
      "name": "Initial load (entry + runtime + vendor chunks index.html preloads)",
      "path": [
        "dist/assets/js/index-*.js",
        "dist/assets/js/rolldown-runtime-*.js",
        "dist/assets/js/react-vendor-*.js",
        "dist/assets/js/router-vendor-*.js",
        "dist/assets/js/vendor-*.js"
      ],
      "limit": "200 KB"
    },
    {
      "name": "Lightbox chunk",
      "path": "dist/assets/js/Lightbox-*.js",
      "limit": "30 KB"
    },
    {
      "name": "HomePage route chunk",
      "path": "dist/assets/js/HomePage-*.js",
      "limit": "50 KB"
    },
    {
      "name": "AlbumDetailPage route chunk",
      "path": "dist/assets/js/AlbumDetailPage-*.js",
      "limit": "50 KB"
    },
    {
      "name": "ImageDetailPage route chunk",
      "path": "dist/assets/js/ImageDetailPage-*.js",
      "limit": "50 KB"
    },
    {
      "name": "SearchResultsPage route chunk",
      "path": "dist/assets/js/SearchResultsPage-*.js",
      "limit": "50 KB"
    },
    {
      "name": "PathResolverPage route chunk",
      "path": "dist/assets/js/PathResolverPage-*.js",
      "limit": "50 KB"
    },
    {
      "name": "Total JavaScript",
      "path": "dist/assets/js/*.js",
      "limit": "500 KB"
    }
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check:dist": "node scripts/check-dist.mjs dist",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build:analyze": "vite build --mode analyze",
    "size-check": "size-limit",
    "size-check:build": "vite build --mode production && size-limit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.19",
    "web-vitals": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@size-limit/file": "^14.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^14.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
