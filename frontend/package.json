{
  "name": "gallery2-to-static-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "size-limit": [
    {
      "path": "dist/assets/js/*.js",
      "limit": "200 KB",
      "name": "Initial bundle (entry + vendor chunks)"
    },
    {
      "path": "dist/assets/js/*-*.js",
      "limit": "50 KB",
      "name": "Individual route chunks"
    },
    {
      "path": "dist/assets/js/lightbox*.js",
      "limit": "30 KB",
      "name": "Lightbox chunk"
    },
    {
      "path": "dist/assets/js/**/*.js",
      "limit": "500 KB",
      "name": "Total bundle size"
    }
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "check:dist": "node scripts/check-dist.mjs dist",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "build:analyze": "vite build --mode analyze",
    "size-check": "size-limit",
    "size-check:build": "vite build --mode production && size-limit"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "react-virtuoso": "^4.18.19",
    "web-vitals": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@size-limit/preset-app": "^11.1.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^11.1.5",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
