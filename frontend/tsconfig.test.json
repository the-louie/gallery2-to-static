{
  // Type-check for the tests (npm run typecheck:test). The build uses tsconfig.json,
  // which covers only the code that ships.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node", "vitest/globals", "@testing-library/jest-dom/vitest"]
  },
  "include": ["src"],
  "exclude": []
}
